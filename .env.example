# ============================================================
#  Abadan Petrochemical – CBM Smart Dashboard
#  Root environment template. Copy to `.env` and adjust.
# ============================================================

# ---- General ----
PROJECT_NAME=abadan-cbm
ENVIRONMENT=development           # development | staging | production
TZ=Asia/Tehran
LOG_LEVEL=INFO

# ---- API Gateway ----
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_CORS_ORIGINS=http://localhost:5173

# ---- Auth / Security (NFR-10..14, ISA/IEC 62443) ----
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=30
ENABLE_2FA=true

# ---- PostgreSQL (asset registry, alerts, work orders, audit) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=abadan_cbm
POSTGRES_USER=cbm
POSTGRES_PASSWORD=cbm-dev-password

# ---- InfluxDB (vibration / acoustic / process time-series) ----
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=abadan
INFLUX_BUCKET=cbm_timeseries
INFLUX_TOKEN=dev-influx-token

# ---- Kafka (high-rate telemetry bus, ISO 13374 data flow) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_VIBRATION=telemetry.vibration
KAFKA_TOPIC_ACOUSTIC=telemetry.acoustic
KAFKA_TOPIC_PROCESS=telemetry.process
KAFKA_TOPIC_FEATURES=analytics.features
KAFKA_TOPIC_DIAGNOSIS=analytics.diagnosis
KAFKA_TOPIC_ALERTS=events.alerts
KAFKA_TOPIC_AUTO_OPS=events.auto_operation

# ---- MQTT (edge sensors / cameras ingest) ----
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_BASE_TOPIC=abadan/edge

# ---- ML / AI Engine ----
MODEL_REGISTRY_PATH=/models
RUL_ALERT_LEAD_TIME_HOURS=72      # FR-12
FAULT_DETECTION_MIN_ACCURACY=0.95 # NFR-08

# ---- Auto Operation ----
AUTO_OP_MODE=advisory             # advisory | supervised | autonomous
AUTO_OP_REQUIRE_HUMAN_APPROVAL=true   # FR-17 Human-in-the-loop
AUTO_OP_MAX_AUTONOMOUS_ACTIONS_PER_HOUR=20

# ---- Grafana (embedded operational panels) ----
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
